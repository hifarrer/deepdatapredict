// KalshiPredict data model
// Auth is handled with a custom JWT-cookie scheme (jose + bcryptjs), so no
// Account/Session/VerificationToken tables are needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PredictionStatus {
  RUNNING
  COMPLETE
  ERROR
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           Role         @default(USER)
  // Prediction credits. Each generated prediction costs 1 credit.
  credits        Int          @default(3)
  // When credits were last reset to the plan quota (lazy monthly reset).
  creditsResetAt DateTime?
  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id])
  createdAt      DateTime     @default(now())
  predictions    Prediction[]
}

model Prediction {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String           @default("kalshi")
  eventTicker    String
  eventTitle     String
  category       String?
  // SEO-friendly public slug, assigned once a prediction COMPLETEs.
  // e.g. "will-zelensky-and-putin-speak-prediction"
  slug           String?          @unique
  status         PredictionStatus @default(RUNNING)
  progress       Int              @default(0)
  stage          String           @default("queued")
  // Kalshi event/markets/candles captured at run time
  kalshiSnapshot Json?
  // Structured AI result (see src/lib/ai/schema.ts)
  result         Json?
  modelUsed      String?
  error          String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
  @@index([eventTicker])
}

// Subscription plans, managed from the admin dashboard.
model Plan {
  id                   String   @id @default(cuid())
  // Stable identifier (free / basic / pro) — used for lookups and seeding.
  slug                 String   @unique
  name                 String
  priceCents           Int      @default(0)
  yearlyPriceCents     Int?
  interval             String   @default("month")
  // Array of feature strings shown on the plans page.
  features             Json?
  // Credits granted to a user on this plan each month.
  monthlyQuota         Int?
  // Stripe price ids for future Stripe integration.
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  users                User[]
}

// Reserved for the future admin dashboard (site settings).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Cached snapshot of live Kalshi events, refreshed by the cron endpoint
// (/api/cron/refresh). A single "live" row holds the full normalized list so
// page loads read the cache instead of hitting Kalshi on every request.
model EventSnapshot {
  id         String   @id @default("live") // singleton row
  events     Json // EventSummary[]
  categories Json // ordered category names
  count      Int      @default(0)
  fetchedAt  DateTime @default(now())
}
